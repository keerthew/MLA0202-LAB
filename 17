import pandas as pd
from sklearn.ensemble import RandomForestClassifier

data = {
    'RAM': [2, 4, 6, 8, 3, 12, 4, 8],
    'Storage': [32, 64, 128, 256, 32, 256, 64, 128],
    'Battery': [3000, 3500, 4000, 4500, 3000, 5000, 3500, 4500],
    'Price_Range': [0, 1, 2, 3, 0, 3, 1, 2]
}

df = pd.DataFrame(data)

X = df[['RAM', 'Storage', 'Battery']]
y = df['Price_Range']

model = RandomForestClassifier(
    n_estimators=100,
    random_state=42
)

model.fit(X, y)

# New mobile for prediction
new_mobile = pd.DataFrame({
    'RAM': [6],
    'Storage': [128],
    'Battery': [4000]
})

prediction = model.predict(new_mobile)

print("Predicted Price Range:", prediction[0])

